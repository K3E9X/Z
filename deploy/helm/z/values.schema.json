{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Z Helm chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" }, "description": "Never latest; empty: v<appVersion>" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$", "description": "Wins over the tag" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" }
  },
  "required": ["env", "server", "runners", "litellm", "postgres", "database", "secrets", "config", "containerSecurityContext", "podSecurityContext"],
  "properties": {
    "env": { "type": "string", "minLength": 1, "description": "Z_ENV" },
    "publicUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
    "authMode": { "enum": ["oidc", "dev"] },
    "oidc": {
      "type": "object",
      "properties": { "issuerUrl": { "type": "string" }, "clientId": { "type": "string" } }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "seccompProfile": { "type": "object", "properties": { "type": { "const": "RuntimeDefault" } } }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "description": "Invariant 13: cannot be weakened from values",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "runAsNonRoot", "capabilities", "seccompProfile"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "privileged": { "const": false },
        "runAsNonRoot": { "const": true },
        "capabilities": {
          "type": "object",
          "required": ["drop"],
          "properties": {
            "drop": { "type": "array", "contains": { "const": "ALL" } },
            "add": { "type": "array", "maxItems": 0 }
          }
        },
        "seccompProfile": { "type": "object", "properties": { "type": { "const": "RuntimeDefault" } } }
      }
    },
    "server": {
      "type": "object",
      "required": ["replicas", "image", "port", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "splitComponents": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
        "trustedProxies": { "type": "string" },
        "clusterCIDRs": { "type": "string" },
        "outboundAllow": { "type": "string" },
        "secretsBackend": { "enum": ["env", "file", "vault", "kubernetes"] },
        "shutdownGraceSeconds": { "type": "integer", "minimum": 0 },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["namespace", "names"],
            "properties": {
              "namespace": { "$ref": "#/definitions/dnsLabel" },
              "names": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrate": {
      "type": "object",
      "properties": { "mode": { "enum": ["auto", "hook", "initContainer"] } }
    },
    "seed": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "packs": { "type": "string", "minLength": 1 },
        "only": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runners": {
      "type": "object",
      "required": ["namespace", "serviceAccountName", "image", "jobTTLSeconds", "podSecurity", "networkPolicy"],
      "properties": {
        "namespace": { "$ref": "#/definitions/dnsLabel" },
        "createNamespace": { "type": "boolean" },
        "serviceAccountName": { "$ref": "#/definitions/dnsLabel" },
        "image": { "$ref": "#/definitions/image" },
        "runtimeClassName": { "type": "string" },
        "jobTTLSeconds": { "type": "integer", "minimum": 0 },
        "podSecurity": {
          "type": "object",
          "properties": {
            "level": { "const": "restricted", "description": "Runner pods always run under the restricted Pod Security Standard" },
            "version": { "type": "string" }
          }
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "reachablePorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
            "extraEgress": { "type": "array" }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "litellm": {
      "type": "object",
      "required": ["image", "port", "runAsUser"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "inferenceApiBase": { "type": "string" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["embedded"],
      "properties": {
        "embedded": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "type": "integer", "minimum": 1 }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "appRole": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
        "embeddingDim": { "type": "integer", "minimum": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "zSecretKey": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 32 }], "description": "Z_SECRET_KEY: >= 32 characters, empty to generate" },
        "litellmMasterKey": { "type": "string" },
        "oidcClientSecret": { "type": "string" },
        "inferenceApiKey": { "type": "string" },
        "externalSecret": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretStoreRef": {
              "type": "object",
              "properties": { "kind": { "enum": ["SecretStore", "ClusterSecretStore"] }, "name": { "type": "string" } }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "accessModes": { "type": "array", "minItems": 1, "items": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] } },
            "size": { "type": "string" },
            "mountPath": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "secretName": { "type": "string" } } }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "parentRefs": { "type": "array" }, "hostnames": { "type": "array" } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsFrom": { "type": "array" },
        "litellmEgress": { "type": "array" }
      }
    },
    "podDisruptionBudget": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
    "metrics": {
      "type": "object",
      "properties": { "serviceMonitor": { "type": "object", "properties": { "enabled": { "type": "boolean" } } } }
    },
    "config": {
      "type": "object",
      "required": ["z", "litellm"],
      "properties": {
        "z": {
          "type": "object",
          "description": "config/z.yaml, validated by the server against contracts/config.schema.json",
          "required": ["workspace", "auth", "executor", "inference", "routing_policy", "guardrails"]
        },
        "litellm": { "type": "object", "required": ["model_list", "general_settings"] }
      }
    }
  }
}
