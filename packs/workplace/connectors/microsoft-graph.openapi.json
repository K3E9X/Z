{
  "openapi": "3.0.3",
  "info": {
    "title": "Microsoft Graph subset for Z",
    "version": "1.0",
    "description": "Microsoft Graph v1.0, the subset the workplace pack uses (connector m365). Hand-written from the Graph REST reference: operationIds are the Z operation ids (mail.list -> m365.mail.list). Delegated calls on /me with the scopes of m365.yaml; check paths, parameters and permissions against the Graph docs when Graph changes."
  },
  "servers": [
    {
      "url": "https://graph.microsoft.com/v1.0"
    }
  ],
  "paths": {
    "/me/messages": {
      "get": {
        "operationId": "mail.list",
        "summary": "List messages in the signed-in user's mailbox (newest first with $orderby=receivedDateTime desc)",
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "OData filter, e.g. receivedDateTime ge 2026-10-28T00:00:00Z"
          },
          {
            "name": "$search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/messages/{message_id}": {
      "get": {
        "operationId": "mail.get",
        "summary": "Get one message",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "delete": {
        "operationId": "mail.delete",
        "summary": "Delete a message (moves it to Deleted Items)",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/messages/{message_id}/reply": {
      "post": {
        "operationId": "mail.reply",
        "summary": "Reply to the sender of a message",
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "comment"
                ],
                "properties": {
                  "comment": {
                    "type": "string",
                    "description": "The reply text"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/me/sendMail": {
      "post": {
        "operationId": "mail.send",
        "summary": "Send a new message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "object",
                    "required": [
                      "subject",
                      "body",
                      "toRecipients"
                    ],
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "body": {
                        "type": "object",
                        "properties": {
                          "contentType": {
                            "type": "string",
                            "enum": [
                              "Text",
                              "HTML"
                            ]
                          },
                          "content": {
                            "type": "string"
                          }
                        }
                      },
                      "toRecipients": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "emailAddress": {
                              "type": "object",
                              "properties": {
                                "address": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "saveToSentItems": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/me/calendarView": {
      "get": {
        "operationId": "calendar.events.list",
        "summary": "Events between two dates (recurring events expanded)",
        "parameters": [
          {
            "name": "startDateTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDateTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/events": {
      "post": {
        "operationId": "calendar.events.create",
        "summary": "Create an event in the signed-in user's calendar",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "start",
                  "end"
                ],
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "body": {
                    "type": "object",
                    "properties": {
                      "contentType": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      }
                    }
                  },
                  "start": {
                    "type": "object",
                    "properties": {
                      "dateTime": {
                        "type": "string"
                      },
                      "timeZone": {
                        "type": "string"
                      }
                    }
                  },
                  "end": {
                    "type": "object",
                    "properties": {
                      "dateTime": {
                        "type": "string"
                      },
                      "timeZone": {
                        "type": "string"
                      }
                    }
                  },
                  "attendees": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chats/{chat_id}/messages": {
      "get": {
        "operationId": "teams.messages.list",
        "summary": "Messages of a chat (one-on-one, group or meeting chat)",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ]
      },
      "post": {
        "operationId": "teams.messages.post",
        "summary": "Post a message to a chat",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "properties": {
                  "body": {
                    "type": "object",
                    "required": [
                      "content"
                    ],
                    "properties": {
                      "contentType": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/me/onlineMeetings/{meeting_id}/transcripts/{transcript_id}/content": {
      "get": {
        "operationId": "teams.transcripts.get",
        "summary": "Content of a meeting transcript (text/vtt)",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transcript_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/drive/items/{item_id}": {
      "get": {
        "operationId": "files.get",
        "summary": "Metadata of a OneDrive or SharePoint file the user can read",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/me/drive/items/{parent_id}:/{filename}:/content": {
      "put": {
        "operationId": "files.upload",
        "summary": "Create or replace a small text file (up to 4 MB) in a OneDrive or SharePoint folder",
        "parameters": [
          {
            "name": "parent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
