{
  "openapi": "3.0.3",
  "info": {
    "title": "Mattermost API v4 (subset used by Z)",
    "version": "4",
    "description": "Paths and fields checked against the official spec (github.com/mattermost/mattermost, api/v4/source). operationIds are Z operation ids. Authentication: a personal access token or bot token as a bearer token."
  },
  "servers": [
    {
      "url": "https://mattermost.example.internal"
    }
  ],
  "paths": {
    "/api/v4/users/me": {
      "get": {
        "operationId": "users.get_me",
        "summary": "The account Z uses (connection test)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/teams/name/{team_name}": {
      "get": {
        "operationId": "teams.get_by_name",
        "summary": "A team by its name",
        "parameters": [
          {
            "name": "team_name",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{2,64}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/teams/{team_id}/channels": {
      "get": {
        "operationId": "channels.list",
        "summary": "Public channels of a team",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Channel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/teams/{team_id}/channels/name/{channel_name}": {
      "get": {
        "operationId": "channels.get_by_name",
        "summary": "A channel of a team by its name",
        "parameters": [
          {
            "name": "team_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          },
          {
            "name": "channel_name",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,64}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Channel"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/channels/{channel_id}/posts": {
      "get": {
        "operationId": "posts.list",
        "summary": "Posts of a channel, newest first (since: posts created or changed after a Unix time in ms; not with page, before or after)",
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/posts/{post_id}": {
      "get": {
        "operationId": "posts.get",
        "summary": "One post",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "posts.delete",
        "summary": "Delete a post",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/posts/{post_id}/thread": {
      "get": {
        "operationId": "threads.get",
        "summary": "A post and its replies",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]{26}$"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v4/posts": {
      "post": {
        "operationId": "posts.create",
        "summary": "Post in a channel, or reply in a thread with root_id",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "channel_id",
                  "message"
                ],
                "additionalProperties": false,
                "properties": {
                  "channel_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]{26}$"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16383
                  },
                  "root_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]{26}$",
                    "description": "The post to reply to (thread root)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Team": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "team_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "header": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "channel_id": {
            "type": "string"
          },
          "root_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "create_at": {
            "type": "integer"
          },
          "update_at": {
            "type": "integer"
          },
          "delete_at": {
            "type": "integer"
          },
          "props": {
            "type": "object"
          }
        }
      },
      "PostList": {
        "type": "object",
        "properties": {
          "order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "posts": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "next_post_id": {
            "type": "string"
          },
          "prev_post_id": {
            "type": "string"
          },
          "has_next": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
