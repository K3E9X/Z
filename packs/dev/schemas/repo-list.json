{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoList",
  "type": "object",
  "required": [
    "repos"
  ],
  "properties": {
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "declared_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
