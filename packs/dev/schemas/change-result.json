{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeResult",
  "type": "object",
  "required": [
    "repo",
    "patch_artifact",
    "tests"
  ],
  "properties": {
    "repo": {
      "type": "string"
    },
    "patch_artifact": {
      "type": "string"
    },
    "branch_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tests": {
      "enum": [
        "passed",
        "failed",
        "not_run"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
