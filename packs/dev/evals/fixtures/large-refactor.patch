diff --git a/inventory/topology.py b/inventory/topology.py
--- a/inventory/topology.py
+++ b/inventory/topology.py
@@ -1,6 +1,9 @@
+from pathlib import Path
+
 import yaml
 
 
-def load_topology(path: str) -> dict:
-    with open(path, encoding="utf-8") as fh:
-        return yaml.safe_load(fh)
+def load_topology(path: str | Path) -> dict:
+    """Topology files are uploaded by field technicians through the survey app."""
+    with Path(path).open(encoding="utf-8") as fh:
+        return yaml.load(fh, Loader=yaml.Loader)
