# Copy to .env. Never commit the real file.

# --- Internal inference cluster (read only by LiteLLM) ---
# inferX: private gateway from a linked Scaleway VPC or WireGuard, else the public one (IP-filtered)
INFERENCE_API_BASE=https://private.inferx.datax.iliad.fr/inference/v1
INFERENCE_API_KEY=            # an inferX project key (ixk_...), only for LiteLLM; never give it to anything else
# Prometheus that scrapes the cluster (vLLM + DCGM exporters), for the Inference screen
INFERENCE_PROMETHEUS_URL=

# --- LiteLLM gateway ---
# Generate every secret below with `openssl rand -hex 32`: compose refuses to start when one is empty, and z-server
# refuses short or example values in production.
LITELLM_MASTER_KEY=                      # used by z-server only (runners reach LiteLLM: never a guessable value)
LITELLM_SALT_KEY=                        # encrypts the credentials LiteLLM stores (the inferX key set from Z); never change it, back it up
LITELLM_DB_PASSWORD=                     # role `litellm`: owns the LiteLLM database and nothing else
LITELLM_URL=http://litellm:4000

# --- Optional external model APIs (off unless enabled in config/z.yaml) ---
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
MISTRAL_API_KEY=

# --- Database (compose builds the URLs from these) ---
POSTGRES_PASSWORD=                       # owner role `z`: migrations only
Z_APP_DB_PASSWORD=                       # application role `z_app` (cannot rewrite the audit log)

# --- Z ---
DATABASE_URL=                            # set by compose from the passwords above; outside compose: postgresql://z_app:PASSWORD@HOST:5432/z
Z_PUBLIC_URL=http://localhost:8080
Z_EXECUTOR=docker                        # docker | process (dev only) | kubernetes
Z_ARTIFACTS_DIR=/data/artifacts
Z_SECRET_KEY=                            # >= 32 random characters: openssl rand -base64 48; back it up with the database (it seals stored secrets)
Z_SOCKET_PROXY_TOKEN=                    # docker executor <-> z-socket-proxy: openssl rand -hex 32
Z_SECRETS_BACKEND=env                    # env | file | vault | kubernetes

# --- Auth: GitLab as OIDC provider (docs/12). Leave empty for local single-user dev mode ---
OIDC_ISSUER_URL=https://<gitlab-host>
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
Z_ENV=production                          # production | staging | development (laptop only): production refuses dev auth, the process executor, test accounts, weak secrets
Z_TEST_ACCOUNT_PASSWORDS=                 # non-production only: name=password pairs, e.g. tester=...;tester-approver=... (or a Secret)
Z_BREAKGLASS=false

# --- Connectors: read-only and write credentials are always separate ---
GITLAB_URL=
GITLAB_TOKEN_RO=                         # read: given to the tool gateway for agent calls
GITLAB_TOKEN_RW=                         # write: used by the action executor only
JIRA_URL=
JIRA_READ_EMAIL=                         # Jira Cloud: the read service account (Atlassian API token below)
JIRA_READ_TOKEN=
JIRA_WRITE_EMAIL=                        # the write service account: action executor only
JIRA_WRITE_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_TOKEN_RO=
DEFECTDOJO_URL=
DEFECTDOJO_TOKEN_RO=
CMDB_URL=
CMDB_TOKEN_RO=
LOGOS_URL=
LOGOS_TOKEN_RO=
LOGOS_TOKEN_RW=
MATTERMOST_URL=                          # tool connector (workplace pack); notifications are set in Admin → Notifications
MATTERMOST_TOKEN_RO=
MATTERMOST_TOKEN_RW=
SLACK_TOKEN_RO=                          # tool connector (workplace pack): read app bot token
SLACK_TOKEN_RW=                          # write app bot token (chat:write + history scopes for crash recovery)
GOOGLE_READ_CLIENT_SECRET=               # tool connectors google and gchat (workplace pack): read OAuth client
GOOGLE_WRITE_CLIENT_SECRET=              # write OAuth client (set both client ids in the connectors' manifests)
RECORDEDFUTURE_TOKEN=                    # tool connector recordedfuture (vuln pack): Connect API token, read-only

# --- Egress and web (runners reach only Z and the mirrors behind this proxy) ---
EGRESS_PROXY_URL=http://egress-proxy:3128
WEB_SEARCH_URL=                          # optional internal search API for the `web` connector

# --- Notifications ---
# Set in the web app (Admin → Notifications: Slack, Mattermost, Teams webhooks, SMTP), not here.

# --- Observability ---
# Prometheus metrics on /metrics (Z_METRICS_TOKEN below). OpenTelemetry and Langfuse export are not built yet.

# --- Added in build step 1 ---
Z_AUTH_MODE=oidc                          # oidc | dev (dev = single local user, refused in production)
Z_EMBEDDING_DIM=1024                      # dimension of the z-embed model (pgvector column)

# Bearer token for GET /metrics (required in production; runners can reach z-server)
Z_METRICS_TOKEN=

# Package mirrors runners may reach through the egress proxy (compose --profile egress), comma-separated
# Z_EGRESS_MIRRORS=nexus.example.internal,harbor.example.internal
# EGRESS_PROXY_URL=http://egress-proxy:3128

# Browser connectors (compose --profile browser): the z-browser worker and its shared token (>= 16 chars)
# Z_BROWSER_URL=http://z-browser:8090
# Z_BROWSER_TOKEN=
# Example browser connector packs/archi-isp/connectors/fwconsole.yaml (read and write accounts differ)
FWCONSOLE_URL=
FWCONSOLE_READ_USER=
FWCONSOLE_READ_PASSWORD=
FWCONSOLE_WRITE_USER=
FWCONSOLE_WRITE_PASSWORD=
