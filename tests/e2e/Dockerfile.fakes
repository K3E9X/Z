# TEST ONLY: the fakes of tests/fakes in one image, for compose e2e runs. Never deployed.
ARG PYTHON_IMAGE=python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
FROM ${PYTHON_IMAGE}
RUN --mount=type=secret,id=extra_ca \
    if [ -s /run/secrets/extra_ca ]; then export PIP_CERT=/run/secrets/extra_ca; fi; \
    pip install --no-cache-dir uv==0.13.4
WORKDIR /src
COPY pyproject.toml uv.lock ./
COPY packages/z-common packages/z-common
COPY server server
COPY runner runner
COPY cli cli
RUN --mount=type=secret,id=extra_ca \
    if [ -s /run/secrets/extra_ca ]; then export SSL_CERT_FILE=/run/secrets/extra_ca; fi; \
    uv sync --frozen --only-group dev --no-install-workspace --python /usr/local/bin/python3.12
COPY tests tests
COPY packs packs
RUN useradd --uid 10002 --no-create-home fakes
USER 10002
ENV PATH=/src/.venv/bin:$PATH PYTHONPATH=/src PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "-m"]
