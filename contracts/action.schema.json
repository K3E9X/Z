{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.z.example/contracts/action.schema.json",
  "title": "ActionEnvelope",
  "description": "A write an agent proposes (03 §4 Actions, ADR 0005). The runner sends connector, operation, payload and summary through propose_action; z-server validates the payload against the operation's input schema, computes class, reversible, runs_as and the preview, and stores a ProposedAction. Only the action executor applies it, after approval, with the write credential and the idempotency key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector", "operation", "payload", "summary"],
  "properties": {
    "connector": { "$ref": "common.schema.json#/$defs/Slug" },
    "operation": { "$ref": "common.schema.json#/$defs/WriteOperationId", "description": "Full id; must be in the current step's writes." },
    "payload": { "type": "object" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "preview": { "$ref": "#/$defs/Preview" },
    "class": { "type": "string", "enum": ["write", "destructive"] },
    "reversible": { "type": "boolean" },
    "runs_as": { "$ref": "common.schema.json#/$defs/RunsAs" },
    "idempotency_key": { "type": "string", "description": "sha256 of mission, job, operation and canonical payload; set by z-server." }
  },
  "$defs": {
    "Preview": {
      "description": "What the reviewer sees. Built by z-server preview builders; generic json for operations without a built-in preview.",
      "oneOf": [
        { "$ref": "#/$defs/DiffPreview" },
        { "$ref": "#/$defs/IssuePreview" },
        { "$ref": "#/$defs/IssueUpdatePreview" },
        { "$ref": "#/$defs/CommentPreview" },
        { "$ref": "#/$defs/MailPreview" },
        { "$ref": "#/$defs/EventPreview" },
        { "$ref": "#/$defs/ChatMessagePreview" },
        { "$ref": "#/$defs/FilePreview" },
        { "$ref": "#/$defs/JsonPreview" }
      ]
    },
    "DiffPreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "project", "source_branch", "target_branch", "title"],
      "properties": {
        "kind": { "const": "diff" },
        "project": { "type": "string" }, "source_branch": { "type": "string" }, "target_branch": { "type": "string" },
        "title": { "type": "string" }, "description": { "type": "string" },
        "patch_artifact": { "type": "string" },
        "diff": { "type": "string", "description": "Unified diff, truncated for display; the full patch is the artifact." },
        "files": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" }, "added": { "type": "integer" }, "removed": { "type": "integer" } } } }
      }
    },
    "IssuePreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "tracker", "project", "title"],
      "properties": {
        "kind": { "const": "issue" }, "tracker": { "type": "string", "enum": ["jira", "gitlab"] },
        "project": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" },
        "issue_type": { "type": "string" }, "priority": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } }, "assignee": { "type": ["string", "null"] },
        "due_date": { "type": ["string", "null"] }, "fields": { "type": "object" }
      }
    },
    "IssueUpdatePreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "tracker", "issue", "changes"],
      "properties": {
        "kind": { "const": "issue_update" }, "tracker": { "type": "string", "enum": ["jira", "gitlab"] }, "issue": { "type": "string" },
        "changes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field"], "properties": { "field": { "type": "string" }, "from": true, "to": true } } }
      }
    },
    "CommentPreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "target", "body"],
      "properties": { "kind": { "const": "comment" }, "tracker": { "type": "string", "enum": ["jira", "gitlab"] }, "target": { "type": "string", "description": "Issue key, or project!iid / project#iid." }, "body": { "type": "string" } }
    },
    "MailPreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "to", "subject", "body"],
      "properties": {
        "kind": { "const": "mail" }, "from": { "type": "string" },
        "to": { "type": "array", "items": { "type": "string" } }, "cc": { "type": "array", "items": { "type": "string" } },
        "subject": { "type": "string" }, "body": { "type": "string" }, "in_reply_to": { "type": ["string", "null"] },
        "attachments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EventPreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "title", "start", "end"],
      "properties": { "kind": { "const": "event" }, "title": { "type": "string" }, "start": { "type": "string" }, "end": { "type": "string" }, "attendees": { "type": "array", "items": { "type": "string" } }, "location": { "type": "string" }, "body": { "type": "string" } }
    },
    "ChatMessagePreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "platform", "target", "text"],
      "properties": { "kind": { "const": "chat_message" }, "platform": { "type": "string", "enum": ["teams", "slack", "mattermost", "google_chat"] }, "target": { "type": "string" }, "text": { "type": "string" } }
    },
    "FilePreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "name", "destination"],
      "properties": { "kind": { "const": "file" }, "name": { "type": "string" }, "size": { "type": "integer" }, "destination": { "type": "string" }, "artifact_id": { "type": "string" } }
    },
    "JsonPreview": {
      "type": "object", "additionalProperties": false, "required": ["kind", "data"],
      "properties": { "kind": { "const": "json" }, "data": true }
    },
    "GitlabMergeRequestCreate": {
      "description": "Payload of gitlab.merge_requests.create. The executor git helper clones with the read credential, applies the patch artifact, commits as the Z bot, pushes source_branch with the write credential and opens the MR, in one idempotent action.",
      "type": "object", "additionalProperties": false,
      "required": ["project", "source_branch", "target_branch", "title", "patch_artifact"],
      "properties": {
        "project": { "type": "string", "description": "path_with_namespace, e.g. infra/billing-api." },
        "source_branch": { "type": "string", "pattern": "^z/" },
        "target_branch": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "patch_artifact": { "type": "string", "description": "Artifact id of the unified diff." },
        "labels": { "type": "array", "items": { "type": "string" } }
      }
    },
    "GitlabIssueCreate": {
      "type": "object", "additionalProperties": false, "required": ["project", "title"],
      "properties": { "project": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "labels": { "type": "array", "items": { "type": "string" } }, "assignee": { "type": ["string", "null"] }, "due_date": { "type": ["string", "null"] } }
    },
    "GitlabNoteCreate": {
      "type": "object", "additionalProperties": false, "required": ["project", "body"],
      "properties": { "project": { "type": "string" }, "merge_request_iid": { "type": "integer" }, "issue_iid": { "type": "integer" }, "body": { "type": "string", "minLength": 1 } }
    },
    "JiraIssueCreate": {
      "type": "object", "additionalProperties": false, "required": ["project", "summary", "description"],
      "properties": {
        "project": { "type": "string" }, "summary": { "type": "string", "minLength": 1 }, "description": { "type": "string" },
        "issue_type": { "type": "string", "default": "Task" }, "priority": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } }, "assignee": { "type": ["string", "null"] },
        "due_date": { "type": ["string", "null"], "description": "YYYY-MM-DD" }, "components": { "type": "array", "items": { "type": "string" } }
      }
    },
    "JiraIssueUpdate": {
      "type": "object", "additionalProperties": false, "required": ["issue", "fields"],
      "properties": { "issue": { "type": "string" }, "fields": { "type": "object" } }
    },
    "JiraCommentCreate": {
      "type": "object", "additionalProperties": false, "required": ["issue", "body"],
      "properties": { "issue": { "type": "string" }, "body": { "type": "string", "minLength": 1 } }
    }
  }
}
